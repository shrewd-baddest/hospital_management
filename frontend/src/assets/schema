CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE TABLE system_info(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    Name VARCHAR(50) NOT NULL,
    Address VARCHAR(100) NOT NULL,
    phone_number VARCHAR(20) NOT NULL,
    email VARCHAR(50) NOT NULL UNIQUE,
    logo VARCHAR(200) NOT NULL
);
CREATE TABLE preference (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id uuid references users(id),
    volume INT DEFAULT 50,
    isSoundOn BOOLEAN DEFAULT TRUE,
    fontSize INT DEFAULT 16,
    isSwitchOn BOOLEAN DEFAULT FALSE,
    theme VARCHAR(100) DEFAULT 'Light' CHECK (theme IN ('Light', 'System', 'Dark'))
);
CREATE TABLE users(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    full_name VARCHAR(50),
    email VARCHAR(100) UNIQUE,
    password VARCHAR(100),
    role VARCHAR(20) CHECK(
        role IN(
            'admin',
            'doctor',
            'nurse',
            'receptionist',
            'patient'
        )
    ),
    profile_image VARCHAR(255),
    phone VARCHAR(20),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE departments(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100),
    head VARCHAR(50),
    beds INT,
    user_id UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE doctors(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    department_id UUID REFERENCES departments(id),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE patients(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    gender VARCHAR(20) DEFAULT 'male' CHECK (gender IN('male', 'female')),
    date_of_birth DATE NOT NULL,
    address TEXT NOT NULL,
    insurance_num(200),
    insurance_provider(100),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE nurses(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    assigned_wards JSONB NOT NULL,
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE receptionists(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE appointments(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID REFERENCES patients(id) NOT NULL,
    doctor_id UUID REFERENCES doctors(id) NOT NULL,
    nurse_id UUID REFERENCES nurses(id) NOT NULL,
    department_id UUID REFERENCES departments(id) NOT NULL,
    appointment_date TIMESTAMP NOT NULL,
    status VARCHAR(20) DEFAULT 'scheduled' CHECK (
        status IN (
            'scheduled',
            'in_progress',
            'completed',
            'cancelled'
        )
    ),
    created_by UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE medical_records(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID REFERENCES patients(id) NOT NULL,
    doctor_id UUID REFERENCES doctors(id) NOT NULL,
    diagnosis TEXT,
    prescriptions JSONB NOT NULL,
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE lab_results(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID REFERENCES patients(id) NOT NULL,
    doctor_id UUID REFERENCES doctors(id) NOT NULL,
    test_name VARCHAR(100) NOT NULL,
    result TEXT,
    status VARCHAR DEFAULT 'pending' CHECK(status IN('pending', 'completed', 'reviewed')),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE wards(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID REFERENCES patients(id) NOT NULL,
    ward_name VARCHAR(50) UNIQUE NOT NULL,
    bed_number BIGSERIAL UNIQUE,
    status VARCHAR(20) DEFAULT 'available' CHECK (status IN('available', 'occupied', 'reserved')),
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE billing(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID REFERENCES patients(id) NOT NULL,
    -- appointment_id UUID REFERENCES appointments(id) NOT NULL,
    sevrvices VARCHAR(255) NOT NULL,
    amount NUMERIC(10, 2) NOT NULL,
    status VARCHAR(20) DEFAULT 'pending' CHECK(status IN('paid', 'pending', 'partially_paid')),
    payment_date TIMESTAMP,
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE roles(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    role_name VARCHAR(50),
    permissions JSONB
);
CREATE TABLE activity (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    table_name VARCHAR(50) NOT NULL,
    action VARCHAR(20) NOT NULL,
    record_id UUID,
    created_at TIMESTAMP DEFAULT NOW()
);
CREATE TABLE admissions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id UUID NOT NULL REFERENCES patients(id),
    admitted_by UUID REFERENCES users(id),
    doctor_id UUID REFERENCES doctors(id),
    ward_id UUID REFERENCES wards(id),
    admission_date TIMESTAMP NOT NULL DEFAULT NOW(),
    discharge_date TIMESTAMP,
    status VARCHAR(20) CHECK (
        status IN (
            'admitted',
            'discharged',
            'transferred',
            'cancelled'
        )
    ) DEFAULT 'admitted'
);
CREATE TABLE doctor_schedules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    doctor_id UUID NOT NULL REFERENCES doctors(id) ON DELETE CASCADE,
    department_id UUID REFERENCES departments(id),
    schedule_date DATE NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    status VARCHAR(20) DEFAULT 'active' CHECK (status IN ('active', 'cancelled', 'completed')),
    created_by UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_time CHECK (start_time < end_time)
);
CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    type VARCHAR(100),
    message VARCHAR(255),
    is_read BOOLEAN DEFAULT FALSE,
    status VARCHAR(100) DEFAULT 'normal' CHECK (status IN ('normal', 'critical')),
    created_at TIMESTAMP DEFAULT NOW()
);
-- TRIGGERS
CREATE OR REPLACE FUNCTION update_appointment_func() RETURNS TRIGGER AS $$ BEGIN
INSERT INTO activity (table_name, action, record_id)
VALUES (
        'appointments',
        NEW.created_by || ' has updated appointment from ' || OLD.status || ' to ' || NEW.status,
        NEW.id
    );
RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER update_appointment_trig
AFTER
UPDATE ON appointments FOR EACH ROW EXECUTE FUNCTION update_appointment_func();
CREATE TRIGGER insert_appointments_trig
AFTER
INSERT ON appointments FOR EACH ROW EXECUTE FUNCTION update_appointment_func();
CREATE OR REPLACE FUNCTION admission_func() RETURNS TRIGGER AS $$ BEGIN
INSERT INTO activity (table_name, action, record_id)
SELECT 'admissions',
    NEW.admitted_by || ' has admitted a new patient ' || p.first_name,
    NEW.id
FROM patients p
WHERE p.id = NEW.patient_id;
RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER admission_trig
AFTER
INSERT ON admissions FOR EACH ROW EXECUTE FUNCTION admission_func();
CREATE OR REPLACE FUNCTION user_register_func() RETURNS TRIGGER AS $$ BEGIN
INSERT INTO activity (table_name, action, record_id)
VALUES (
        'users',
        'New user registered with email: ' || NEW.email,
        NEW.id
    );
RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER user_register_trig
AFTER
INSERT ON users FOR EACH ROW EXECUTE FUNCTION user_register_func();
CREATE OR REPLACE FUNCTION user_update_func() RETURNS TRIGGER AS $$ BEGIN
INSERT INTO activity (table_name, action, record_id)
VALUES (
        'users',
        'User with email: ' || NEW.email || ' has updated their profile.',
        NEW.id
    );
RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER user_update_trig
AFTER
UPDATE ON users FOR EACH ROW EXECUTE FUNCTION user_update_func();
CREATE OR REPLACE FUNCTION admissionStatus_func() RETURNS TRIGGER AS $$ BEGIN
INSERT INTO activity (table_name, action, record_id)
SELECT 'admissions',
    NEW.admitted_by || ' has ' || NEW.status || ' patient ' || p.first_name,
    NEW.id
FROM patients p
WHERE p.id = NEW.patient_id;
RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER discharge_trig
AFTER
UPDATE ON admissions FOR EACH ROW EXECUTE FUNCTION admissionStatus_func();